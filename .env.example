# Payment configuration
VITE_PAYMENT_API_URL=/api/payments
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Server-only Google OAuth. Never prefix secrets with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register APP_URL + /api/auth/google/callback in Google Auth Platform > Clients.
APP_URL=http://127.0.0.1:5173
# Required in production, use at least 32 random characters.
SESSION_SECRET=
# Required in production. Railway: reference the private Postgres service.
DATABASE_URL=
# Verified Google email of the owner. Never assign ownership to the first visitor.
OWNER_EMAIL=
