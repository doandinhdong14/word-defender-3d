# Optional trusted backend, never put payOS secret keys in VITE_ variables.
# POST /checkout accepts { packageId } and returns { checkoutUrl }.
VITE_PAYMENT_API_URL=

# Server-only Google OAuth. Never prefix secrets with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register APP_URL + /api/auth/google/callback in Google Auth Platform > Clients.
APP_URL=http://localhost:5173
# Required in production, use at least 32 random characters.
SESSION_SECRET=
